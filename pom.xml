<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jftse</groupId>
    <artifactId>emulator-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>JFTSE Emulator</name>
    <description>Fantasy Tennis server emulator</description>
    <packaging>pom</packaging>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <repositories>
        <repository>
            <id>central maven repository</id>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
    </repositories>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>21</java.version>
        <log4j2.version>2.25.3</log4j2.version>
        <lombok.version>1.18.42</lombok.version>
        <netty.version>4.1.131.Final</netty.version>
    </properties>

    <modules>
        <module>entities</module>
        <module>auth-server</module>
        <module>commons</module>
        <module>server-core</module>
        <module>game-server</module>
		<module>chat-server</module>
        <module>relay-server</module>
        <module>ac-server</module>
        <module>commons-proto</module>
        <module>packet-generator</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <windowtitle>JFTSE API</windowtitle>
                    <doctitle><![CDATA[<h1>JFTSE Emulator API</h1>]]></doctitle>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Optional, private plugin modules live under plugins/ and are .gitignore'd - they're
         never in a public clone. Each is only added to the reactor when its pom.xml actually
         exists on disk, so a public clone (no plugins/ directory) builds normally without any
         profile flag; on a machine that has them (private plugin dev), they're picked up
         automatically. See plugins/tower-mode/PLUGIN_ARCHITECTURE_PLAN.md. -->
    <profiles>
        <profile>
            <id>with-tower-mode</id>
            <activation>
                <file>
                    <exists>plugins/tower-mode/pom.xml</exists>
                </file>
            </activation>
            <modules>
                <module>plugins/tower-mode</module>
            </modules>
        </profile>
    </profiles>
</project>